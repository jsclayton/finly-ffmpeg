--- a/libavcodec/bsf/dovi_rpu.c
+++ b/libavcodec/bsf/dovi_rpu.c
@@ -33,6 +33,14 @@
 
 #include "libavcodec/hevc/hevc.h"
 
+/* finly-ffmpeg: `convert` option values. NONE keeps this filter byte-for-byte
+   what upstream does; P81 turns a dual-layer profile 7 stream into a single-layer
+   profile 8.1 one. */
+enum {
+    DOVI_CONVERT_NONE = 0,
+    DOVI_CONVERT_P81  = 1,
+};
+
 typedef struct DoviRpuContext {
     CBSBSFContext common;
     DOVIContext dec;
@@ -40,6 +48,7 @@
 
     int strip;
     int compression;
+    int convert;
 } DoviRpuContext;
 
 static int update_rpu(AVBSFContext *bsf, const AVPacket *pkt, int flags,
@@ -66,6 +75,19 @@
         return ret;
     }
 
+    /* finly-ffmpeg: profile 7 -> 8.1 is exactly three field mutations. Measured by
+       diffing dovi_tool's own conversion (modes 2 and 5, which are byte-identical
+       for a profile 7 input) against the source RPU, frame by frame: nothing else
+       changes. In particular the luma/chroma reshaping curves are PRESERVED --
+       whatever the "removes mapping" wording suggests, no mapping is removed.
+       ff_dovi_rpu_generate() then simply omits the whole NLQ section, because it
+       writes it only when nlq_method_idc != AV_DOVI_NLQ_NONE. */
+    if (s->convert == DOVI_CONVERT_P81) {
+        av_dovi_get_header(metadata)->disable_residual_flag = 1;
+        av_dovi_get_header(metadata)->el_spatial_resampling_filter_flag = 0;
+        av_dovi_get_mapping(metadata)->nlq_method_idc = AV_DOVI_NLQ_NONE;
+    }
+
     if (pkt && !(pkt->flags & AV_PKT_FLAG_KEY))
         flags |= FF_DOVI_COMPRESS_RPU;
     ret = ff_dovi_rpu_generate(&s->enc, metadata, flags, out_rpu, out_size);
@@ -84,6 +106,30 @@
     uint8_t *rpu = NULL;
     int rpu_size, ret;
 
+    /* finly-ffmpeg: convert=p81 finds the RPU wherever it sits in the access unit
+       rather than only in the last NAL. Upstream's probe below is correct for its
+       own uses -- strip and recompression both no-op harmlessly when the RPU is not
+       last -- but a conversion that no-ops is not harmless: dovi_rpu_init() has
+       already rewritten the configuration record to profile 8.1, so the output
+       would declare 8.1 while still carrying an unconverted profile 7 RPU. This
+       reassigns upstream's own `nal` rather than replacing its initialisation, so
+       it costs no removed line. An access unit with no RPU is left alone, as
+       upstream leaves it. The enhancement layer never reaches this filter on the
+       conversion path: dovi_split=mode=bl_rpu runs ahead of it and removes the
+       UNSPEC63 NALs. `strip` cannot be set here -- dovi_rpu_init() rejects the
+       combination -- so the positional deletion below stays unreachable. */
+    if (s->convert == DOVI_CONVERT_P81) {
+        nal = NULL;
+        for (int i = au->nb_units - 1; i >= 0; i--) {
+            if (au->units[i].type == HEVC_NAL_UNSPEC62) {
+                nal = &au->units[i];
+                break;
+            }
+        }
+        if (!nal)
+            return 0;
+    }
+
     // HEVC_NAL_UNSPEC62 is Dolby Vision RPU and HEVC_NAL_UNSPEC63 is Dolby Vision EL
     if (!nal || (nal->type != HEVC_NAL_UNSPEC62 && nal->type != HEVC_NAL_UNSPEC63))
         return 0;
@@ -205,6 +251,21 @@
     if (s->compression == AV_DOVI_COMPRESSION_RESERVED) {
         av_log(bsf, AV_LOG_ERROR, "Invalid compression level: %d\n", s->compression);
         return AVERROR(EINVAL);
+    }
+
+    /* finly-ffmpeg: converting and stripping are contradictory requests, and a
+       converted stream must not also carry compressed metadata -- ff_dovi_configure()
+       itself warns that compression "for profile 8 is known to be unsupported by
+       many devices", and nothing downstream has been verified against it. Forcing
+       it here (rather than rejecting a non-default `compression`) also keeps the
+       profile<8 compression check below from firing on the profile 7 input we are
+       about to convert. */
+    if (s->convert != DOVI_CONVERT_NONE) {
+        if (s->strip) {
+            av_log(bsf, AV_LOG_ERROR, "strip and convert are mutually exclusive\n");
+            return AVERROR(EINVAL);
+        }
+        s->compression = AV_DOVI_COMPRESSION_NONE;
     }
 
     if (s->strip) {
@@ -230,8 +291,43 @@
                 return AVERROR(EINVAL);
             }
 
+            /* finly-ffmpeg: rewrite the configuration record to describe the
+               single-layer output. This mutates the caller's side data in place
+               (as the compression assignment above already does), so bsf->par_out
+               carries the converted record and a muxer reading it writes a `dvvC`
+               -- movenc picks the fourcc off dv_profile -- with no second source of
+               truth. bl_signal_compatibility_id becomes 1 (HDR10-compatible base);
+               on the profile 7 input those four bits are RESERVED in a v1.0 dvcC
+               and hold a meaningless value, so this is a write, never an edit.
+               el_present_flag is cleared here too, although dovi_split has already
+               cleared it in the record this filter receives -- the enhancement
+               layer, and the layer's own configuration record (exported as
+               AV_PKT_DATA_HEVC_CONF and written back as an `hvcE` box), are both
+               removed upstream by dovi_split=mode=bl_rpu, which consumers chain
+               ahead of this filter and whose par_out must be carried into this
+               filter's par_in. */
+            if (s->convert == DOVI_CONVERT_P81) {
+                if (s->dec.cfg.dv_profile != 7) {
+                    av_log(bsf, AV_LOG_ERROR, "convert=p81 requires a Dolby Vision "
+                           "profile 7 input, got profile %d.\n", s->dec.cfg.dv_profile);
+                    return AVERROR(EINVAL);
+                }
+                cfg->dv_profile = 8;
+                cfg->dv_bl_signal_compatibility_id = 1;
+                cfg->el_present_flag = 0;
+                cfg->dv_md_compression = AV_DOVI_COMPRESSION_NONE;
+            }
+
             s->enc.cfg = *cfg;
         } else {
+            if (s->convert != DOVI_CONVERT_NONE) {
+                /* finly-ffmpeg: without a record there is nothing to assert the
+                   input is profile 7, and a guessed one would silently mislabel
+                   the output. Refuse rather than convert blind. */
+                av_log(bsf, AV_LOG_ERROR, "convert requires a Dolby Vision "
+                       "configuration record on the input stream.\n");
+                return AVERROR(EINVAL);
+            }
             av_log(bsf, AV_LOG_WARNING, "No Dolby Vision configuration record "
                    "found? Generating one, but results may be invalid.\n");
             ret = ff_dovi_configure_from_codedpar(&s->enc, bsf->par_out, NULL, s->compression,
@@ -270,6 +366,10 @@
         { "none",       "Don't compress metadata",      0, AV_OPT_TYPE_CONST, {.i64 = 0},                            .flags = FLAGS, .unit = "compression" },
         { "limited",    "Limited metadata compression", 0, AV_OPT_TYPE_CONST, {.i64 = AV_DOVI_COMPRESSION_LIMITED},  .flags = FLAGS, .unit = "compression" },
         { "extended",   "Extended metadata compression",0, AV_OPT_TYPE_CONST, {.i64 = AV_DOVI_COMPRESSION_EXTENDED}, .flags = FLAGS, .unit = "compression" },
+    /* finly-ffmpeg */
+    { "convert",        "Convert the stream to another DV profile", OFFSET(convert), AV_OPT_TYPE_INT, { .i64 = DOVI_CONVERT_NONE }, DOVI_CONVERT_NONE, DOVI_CONVERT_P81, FLAGS, .unit = "convert" },
+        { "none",       "No conversion",                0, AV_OPT_TYPE_CONST, {.i64 = DOVI_CONVERT_NONE}, .flags = FLAGS, .unit = "convert" },
+        { "p81",        "Dual-layer profile 7 to single-layer profile 8.1", 0, AV_OPT_TYPE_CONST, {.i64 = DOVI_CONVERT_P81}, .flags = FLAGS, .unit = "convert" },
     { NULL }
 };
 
